# Copy to .env and adjust. Everything except DATABASE_URL/APP_URL/ENCRYPTION_KEY is optional.

DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# 32 bytes as 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Dev only: lets managers add repos by server folder path
ALLOW_LOCAL_REPOS="true"

# --- AI Providers (Gemini & Groq Free Tiers with Automatic Load Balancing) ---
# Google Gemini API key (Free tier: 1,500 requests/day at https://aistudio.google.com)
# Used primarily for codebase chunk analysis, module summaries, and manager reports.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Groq API key (Free fast tier at https://console.groq.com)
# Used primarily for ultra-low latency candidate workspace chat and public "Chat with us" widget.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"

# Optional additional providers:
# xAI Grok API key (https://console.x.ai)
GROK_API_KEY=""
# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# --- GitHub Integration (Optional in dev, runs with simulator/dev form without keys) ---
# Candidate GitHub login (OAuth App). Blank = dev form that asks for a username.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Private repo access + real issue creation + PR file/commit enrichment
GITHUB_TOKEN=""
# Verifies webhook signatures at /api/github/webhook (required in production)
GITHUB_WEBHOOK_SECRET=""

# Set true to hide the in-app scheduler (deadline reminders / weekly reports every 15 min)
DISABLE_SCHEDULER="false"
