# Copy to .env and adjust. Everything except DATABASE_URL/APP_URL/ENCRYPTION_KEY is optional.

DATABASE_URL="postgresql://user:pass@localhost:5432/brainwhite"
APP_URL="http://localhost:3000"

# 32 bytes as 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Dev only: lets managers add repos by server folder path
ALLOW_LOCAL_REPOS="true"

# --- AI Providers (Gemini & Groq Free Tiers with Automatic Load Balancing) ---
# Google Gemini API key (Free tier: 1,500 requests/day at https://aistudio.google.com)
# Used primarily for codebase chunk analysis, module summaries, and manager reports.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_REPORT_MODEL="gemini-2.5-pro"

# Groq API key (Free fast tier at https://console.groq.com)
# Used primarily for ultra-low latency candidate workspace chat and public "Chat with us" widget.
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_FAST_MODEL="openai/gpt-oss-20b"

# Optional additional providers:
# xAI Grok API key (https://console.x.ai)
GROK_API_KEY=""
# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=""

# --- GitHub Integration (Optional in dev, runs with simulator/dev form without keys) ---
# Candidate GitHub login (OAuth App). Blank = dev form that asks for a username.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Private repo access + real issue creation + PR file/commit enrichment
GITHUB_TOKEN=""
# Verifies webhook signatures at /api/github/webhook (required in production)
GITHUB_WEBHOOK_SECRET=""

# --- Google OAuth (Optional) ---
# Google OAuth 2.0 Client ID/Secret from Google Cloud Console
# Enables "Sign up with Google" on auth pages. Blank = button shows "not configured" state.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Set true to hide the in-app scheduler (deadline reminders / weekly reports every 15 min)
DISABLE_SCHEDULER="false"

# --- Resend Email (PLT-07) ---
# Get API key from https://resend.com (Free tier: 100 emails/day)
# Verify your domain or use onboarding@resend.dev for testing
RESEND_API_KEY=""
FROM_EMAIL="BrainWhite <onboarding@brainwhite.com>"

# --- Supabase Auth (Optional - enables social login + user management) ---
# Get these from https://app.supabase.com (Free tier)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Slides & Diagrams Module (PLT-09) ---
# Uses GEMINI_API_KEY / GROQ_API_KEY from above for AI slide generation